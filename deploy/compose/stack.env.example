# Host settings for deploy/compose/compose.yaml. Copy to ${DIYNCRAFTS_ETC}/stack.env
# (default /etc/diyncrafts/stack.env). No secrets belong in this file.

# "staging" or "production"; appears in logs and metrics.
APP_ENVIRONMENT=staging

# Public DNS name served by this host (Caddy obtains its certificate automatically).
# REQUIRED. Example only: replace with the real domain.
SITE_ADDRESS=staging.example.com

# Allowed image repositories. The deploy script refuses any other image and any reference that is
# not pinned by digest (repository@sha256:...).
BACKEND_REPOSITORY=ghcr.io/rcgchandu/diyncrafts
FRONTEND_REPOSITORY=ghcr.io/rcgchandu/diyncrafts-frontend

# Content-Security-Policy origins for the frontend: where media (DASH, thumbnails) is served from,
# i.e. the scheme+host of APP_STORAGE_PUBLIC_BASE_URL. API_ORIGIN only if the API is on another origin.
MEDIA_ORIGIN=https://media.example.com
API_ORIGIN=

# Upload limits (keep MAX_UPLOAD_SIZE in step with spring.servlet.multipart.max-request-size).
MAX_UPLOAD_SIZE=2GiB
UPLOAD_READ_TIMEOUT=1h

# Host paths.
DATA_DIR=/var/lib/diyncrafts
EDGE_DIR=/var/lib/diyncrafts-edge
SECRETS_DIR=/etc/diyncrafts/secrets

# Resource limits per container. Starting points: tune from real measurements.
API_MEMORY=2g
API_CPUS=1.5
WORKER_MEMORY=3g
WORKER_CPUS=2
