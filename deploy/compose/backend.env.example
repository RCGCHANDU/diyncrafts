# Non-secret Spring configuration for the api and worker containers. Copy to
# ${DIYNCRAFTS_ETC}/backend.env (default /etc/diyncrafts/backend.env).
#
# Secrets are NOT set here. Each one is a file in ${SECRETS_DIR}/backend/ named after the property
# (Spring configtree), readable by UID 10001 only:
#   app.jwt.secret                    (required, >= 32 characters: openssl rand -base64 48)
#   spring.datasource.password        (required)
#   spring.rabbitmq.password          (required; also used by the STOMP relay)
#   spring.elasticsearch.password     (when Elasticsearch security is enabled)
#   app.bootstrap-admin.password      (optional, first start only; remove afterwards)
# See docs/deployment/ENVIRONMENTS.md.

# MySQL. Use TLS to a managed database, e.g. append ?sslMode=VERIFY_IDENTITY
SPRING_DATASOURCE_URL=jdbc:mysql://mysql.internal.example:3306/diyncraftshub
SPRING_DATASOURCE_USERNAME=diyncrafts

# RabbitMQ (AMQP) and the STOMP relay used for live progress (rabbitmq_stomp plugin).
SPRING_RABBITMQ_HOST=rabbitmq.internal.example
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=diyncrafts
# SPRING_RABBITMQ_VIRTUAL_HOST=/
# SPRING_RABBITMQ_SSL_ENABLED=true       # managed brokers usually require TLS (port 5671)
APP_WEBSOCKET_RELAY_HOST=rabbitmq.internal.example
APP_WEBSOCKET_RELAY_PORT=61613

# Elasticsearch. Use https:// with a certificate the JVM trusts; never disable verification.
SPRING_ELASTICSEARCH_URIS=https://search.internal.example:9200
# SPRING_ELASTICSEARCH_USERNAME=diyncrafts

# Object storage. Leave APP_STORAGE_ENDPOINT unset for AWS S3.
APP_STORAGE_BUCKET=replace-with-bucket-name
APP_STORAGE_REGION=replace-with-bucket-region
# APP_STORAGE_ENDPOINT=https://s3-compatible.example
# APP_STORAGE_PATH_STYLE_ACCESS=true
# Public URL of stored media (a CDN in front of the bucket is recommended). Its origin must be
# MEDIA_ORIGIN in stack.env, and the bucket/CDN must allow CORS GET from the site origin.
APP_STORAGE_PUBLIC_BASE_URL=https://media.example.com

# Browser origin(s) of the site (REST CORS and the WebSocket origin check). Never "*".
APP_CORS_ALLOWED_ORIGINS=https://staging.example.com

# Transcoding. h264_nvenc needs an NVIDIA host with the NVIDIA container runtime.
# APP_TRANSCODING_ENCODER=libx264
# Refuse uploads (503) when accepting one would leave less than this on the scratch disk.
# APP_TRANSCODING_MIN_FREE_SPACE=2GB

# Optional first administrator (password as a secret file, see above).
# APP_BOOTSTRAP_ADMIN_USERNAME=admin
# APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# AWS credentials: prefer an instance role / workload identity (containers need IMDSv2 hop limit 2).
# Static keys, if unavoidable, go in ${SECRETS_DIR}/aws.env (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY).
