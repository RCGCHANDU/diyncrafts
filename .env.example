# Copy to .env (git-ignored) and fill in real values. Never commit real secrets.
# Spring Boot maps these environment variables onto configuration properties.

# Required: HS256 JWT signing key, at least 32 characters. Generate with: openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-value

# MySQL (the "local" profile already points at docker-compose; override for other environments)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/diyncraftshub
SPRING_DATASOURCE_USERNAME=diyncrafts
SPRING_DATASOURCE_PASSWORD=change-me

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_USERNAME=diyncrafts
SPRING_RABBITMQ_PASSWORD=change-me

# Elasticsearch (username/password only if security is enabled on the cluster)
SPRING_ELASTICSEARCH_URIS=http://localhost:9200
SPRING_ELASTICSEARCH_USERNAME=
SPRING_ELASTICSEARCH_PASSWORD=

# AWS: credentials are resolved by the standard AWS provider chain. Prefer an instance/task role or
# a named profile (AWS_PROFILE); plain keys are supported but must never be committed.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: create an initial administrator on startup if the username does not exist yet.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_EMAIL=
